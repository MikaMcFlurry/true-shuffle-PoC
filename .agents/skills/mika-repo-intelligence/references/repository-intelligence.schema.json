{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mika.local/schemas/repository-intelligence.v2.json",
  "title": "Mika Repository Intelligence Packet V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_status", "generated_at", "analysis_modes", "repositories", "primary_baseline", "authority_map", "product", "features", "architecture", "quality", "gaps", "owner_alignment", "handoff_readiness", "recommendation", "evidence"],
  "properties": {
    "schema_version": {"const": "mika.repository-intelligence.v2"},
    "packet_status": {"enum": ["ANALYZED", "ALIGNED", "BLOCKED"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "analysis_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["AUTO", "LIVE_BASELINE", "LOST_CONTEXT", "SPEC_IMPLEMENTATION_GAP", "PORTFOLIO_RESOLUTION"]}},
    "repositories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repository"}},
    "primary_baseline": {"$ref": "#/$defs/baseline"},
    "authority_map": {"$ref": "#/$defs/authorityMap"},
    "product": {"$ref": "#/$defs/product"},
    "features": {"type": "array", "items": {"$ref": "#/$defs/feature"}},
    "architecture": {"$ref": "#/$defs/architecture"},
    "quality": {"$ref": "#/$defs/quality"},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "owner_alignment": {"$ref": "#/$defs/ownerAlignment"},
    "handoff_readiness": {"$ref": "#/$defs/handoffReadiness"},
    "recommendation": {"$ref": "#/$defs/recommendation"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "full_name", "url", "role", "visibility", "default_branch", "ref", "commit_sha", "notes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "full_name": {"type": "string", "minLength": 3},
        "url": {"type": ["string", "null"]},
        "role": {"enum": ["CURRENT_PRIMARY", "CURRENT_COMPONENT", "PRODUCTION_SOURCE", "SUCCESSOR", "LEGACY", "EXPERIMENT", "HANDOFF_ONLY", "ARCHIVE", "DUPLICATE", "UNRESOLVED"]},
        "visibility": {"enum": ["public", "private", "internal", "unknown"]},
        "default_branch": {"type": ["string", "null"]},
        "ref": {"type": "string", "minLength": 1},
        "commit_sha": {"$ref": "#/$defs/sha"},
        "notes": {"type": "string"}
      }
    },
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_id", "ref", "commit_sha", "deployment_refs", "unavailable_systems"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "commit_sha": {"$ref": "#/$defs/sha"},
        "deployment_refs": {"$ref": "#/$defs/stringArray"},
        "unavailable_systems": {"$ref": "#/$defs/stringArray"}
      }
    },
    "conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "axis", "status", "claims", "evidence_ids", "blocking", "resolution"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "axis": {"enum": ["CURRENT_REALITY", "TARGET_INTENT", "GOVERNANCE"]},
        "status": {"enum": ["RESOLVED", "UNRESOLVED", "OWNER_DECISION", "GOVERNANCE_DECISION"]},
        "claims": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"$ref": "#/$defs/stringArray"},
        "blocking": {"type": "boolean"},
        "resolution": {"type": ["string", "null"]}
      }
    },
    "authorityMap": {
      "type": "object", "additionalProperties": false,
      "required": ["current_reality_evidence_ids", "target_intent_evidence_ids", "governance_evidence_ids", "conflicts"],
      "properties": {
        "current_reality_evidence_ids": {"$ref": "#/$defs/stringArray"},
        "target_intent_evidence_ids": {"$ref": "#/$defs/stringArray"},
        "governance_evidence_ids": {"$ref": "#/$defs/stringArray"},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type", "status", "evidence_ids"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["LOCAL", "PREVIEW", "STAGING", "PRODUCTION", "STORE", "UNKNOWN"]},
        "status": {"enum": ["VERIFIED", "UNVERIFIED", "BLOCKED", "UNKNOWN"]},
        "evidence_ids": {"$ref": "#/$defs/stringArray"}
      }
    },
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "summary", "users", "delivery_state", "environments", "owner_satisfaction"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "users": {"$ref": "#/$defs/stringArray"},
        "delivery_state": {"enum": ["PLANNING", "PROTOTYPE", "ALPHA", "BETA", "RELEASE_CANDIDATE", "LIVE", "MIXED", "UNKNOWN"]},
        "environments": {"type": "array", "items": {"$ref": "#/$defs/environment"}},
        "owner_satisfaction": {"enum": ["SATISFIED", "MIXED", "DISSATISFIED", "UNKNOWN"]}
      }
    },
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "group", "evidence_state", "owner_disposition", "summary", "evidence_ids", "quality_note"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "group": {"type": "string", "minLength": 1},
        "evidence_state": {"enum": ["VERIFIED_LIVE", "VERIFIED_RUNTIME_NONPROD", "IMPLEMENTED_TESTED", "IMPLEMENTED_UNVERIFIED", "PARTIAL", "PLANNED_ONLY", "DISABLED_OR_HIDDEN", "DEPRECATED_OR_DEAD", "CONTRADICTED", "UNKNOWN"]},
        "owner_disposition": {"enum": ["KEEP", "IMPROVE", "REDESIGN", "REMOVE", "ADD", "PIVOT", "DEFER", "STUDIO_DECIDES", "UNDECIDED"]},
        "summary": {"type": "string", "minLength": 1},
        "evidence_ids": {"$ref": "#/$defs/stringArray"},
        "quality_note": {"type": "string"}
      }
    },
    "architectureItem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "summary", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "evidence_ids": {"$ref": "#/$defs/stringArray"}
      }
    },
    "architectureSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "evidence_ids"],
      "properties": {"summary": {"type": "string", "minLength": 1}, "evidence_ids": {"$ref": "#/$defs/stringArray"}}
    },
    "architecture": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "components", "data_stores", "integrations", "deployment", "operations"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "components": {"type": "array", "items": {"$ref": "#/$defs/architectureItem"}},
        "data_stores": {"type": "array", "items": {"$ref": "#/$defs/architectureItem"}},
        "integrations": {"type": "array", "items": {"$ref": "#/$defs/architectureItem"}},
        "deployment": {"$ref": "#/$defs/architectureSummary"},
        "operations": {"$ref": "#/$defs/architectureSummary"}
      }
    },
    "qualityCheck": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "status", "evidence_ids", "notes"],
      "properties": {
        "category": {"enum": ["build", "tests", "runtime", "security", "accessibility", "performance", "operations", "migration", "recovery"]},
        "status": {"enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED", "CLAIM_ONLY", "UNKNOWN"]},
        "evidence_ids": {"$ref": "#/$defs/stringArray"},
        "notes": {"type": "string"}
      }
    },
    "quality": {
      "type": "object", "additionalProperties": false,
      "required": ["checks"],
      "properties": {"checks": {"type": "array", "items": {"$ref": "#/$defs/qualityCheck"}}}
    },
    "gap": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "class", "severity", "summary", "evidence_ids", "owner_decision_required", "blocking", "resolution_decision_id", "recommended_resolution"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "class": {"enum": ["PLANNED_NOT_IMPLEMENTED", "IMPLEMENTED_NOT_DOCUMENTED", "DOCUMENTED_BUT_STALE", "TESTED_BUT_NOT_DEPLOYED", "DEPLOYED_BUT_NOT_REPRODUCIBLE", "LIVE_BUT_NOT_OBSERVABLE", "FEATURE_PRESENT_BUT_OWNER_REJECTED", "DUPLICATE_OR_SUPERSEDED", "AUTHORITY_CONFLICT", "UNVERIFIED_CLAIM"]},
        "severity": {"enum": ["P0", "P1", "P2", "P3", "INFO"]},
        "summary": {"type": "string", "minLength": 1},
        "evidence_ids": {"$ref": "#/$defs/stringArray"},
        "owner_decision_required": {"type": "boolean"},
        "blocking": {"type": "boolean"},
        "resolution_decision_id": {"type": ["string", "null"]},
        "recommended_resolution": {"type": "string", "minLength": 1}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "decision", "status", "material", "recommended_answer", "owner_answer", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "decision": {"type": "string", "minLength": 1},
        "status": {"enum": ["RESOLVED", "DELEGATED", "NOT_BLOCKING", "OPEN"]},
        "material": {"type": "boolean"},
        "recommended_answer": {"type": "string", "minLength": 1},
        "owner_answer": {"type": ["string", "null"]},
        "evidence_ids": {"$ref": "#/$defs/stringArray"}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "decision", "disposition", "source", "recorded_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "decision": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["KEEP", "IMPROVE", "REDESIGN", "REMOVE", "ADD", "PIVOT", "DEFER", "STUDIO_DECIDES"]},
        "source": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "ownerAlignment": {
      "type": "object", "additionalProperties": false,
      "required": ["questions", "decisions"],
      "properties": {
        "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}
      }
    },
    "handoffReadiness": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "blocker_ids", "reason"],
      "properties": {
        "status": {"enum": ["READY", "NOT_READY", "BLOCKED"]},
        "blocker_ids": {"$ref": "#/$defs/stringArray"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "recommendation": {
      "type": "object", "additionalProperties": false,
      "required": ["engagement_types", "handoff_profiles", "read_first", "next_action"],
      "properties": {
        "engagement_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["TAKEOVER", "RESCUE", "MODERNIZE", "FEATURE", "MIGRATION", "RELEASE", "GOVERNED_EXECUTION", "EXPERIMENT"]}},
        "handoff_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["LEAN", "STANDARD", "LIVE_SYSTEM", "GOVERNED", "MULTI_REPO"]}},
        "read_first": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "evidence_level", "claim", "repository_id", "ref", "commit_sha", "path_or_url", "environment", "artifact_ref", "observed_at", "source_status", "sensitivity"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["REPOSITORY", "FILE", "COMMIT", "BRANCH", "PULL_REQUEST", "ISSUE", "CI", "TEST_RUN", "RUNTIME", "DEPLOYMENT", "PROVIDER", "OWNER_STATEMENT", "EXTERNAL_SOURCE"]},
        "evidence_level": {"enum": ["OBSERVED_RUNTIME", "PROVIDER_CONFIRMED", "CODE_CONFIRMED", "TEST_CONFIRMED", "CI_CONFIRMED", "DOC_CORROBORATED", "CLAIM_ONLY", "INFERRED", "UNKNOWN"]},
        "claim": {"type": "string", "minLength": 1},
        "repository_id": {"type": ["string", "null"]},
        "ref": {"type": ["string", "null"]},
        "commit_sha": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "path_or_url": {"type": ["string", "null"]},
        "environment": {"type": ["string", "null"]},
        "artifact_ref": {"type": ["string", "null"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "source_status": {"enum": ["AUTHORITATIVE", "CURRENT_SUPPORTING", "STALE", "CONTRADICTED", "HISTORICAL", "UNRESOLVED"]},
        "sensitivity": {"enum": ["PUBLIC", "INTERNAL", "SENSITIVE_REDACTED"]}
      }
    }
  }
}
