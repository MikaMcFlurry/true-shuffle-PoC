{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mika.local/schemas/repo-handoff-map.v2.json",
  "title": "Mika Repository Handoff Map V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "map_path", "profiles", "analysis_baseline", "write_scope", "roles"],
  "properties": {
    "schema_version": {"const": "mika.repo-handoff-map.v2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "map_path": {"$ref": "#/$defs/safePath"},
    "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["LEAN", "STANDARD", "LIVE_SYSTEM", "GOVERNED", "MULTI_REPO"]}},
    "analysis_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "repository", "ref", "commit_sha", "intelligence_schema", "intelligence_status", "packet_sha256"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 3},
        "ref": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
        "intelligence_schema": {"const": "mika.repository-intelligence.v2"},
        "intelligence_status": {"const": "ALIGNED"},
        "packet_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "write_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_commit", "branch", "allowed_paths"],
      "properties": {
        "base_commit": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
        "branch": {"type": "string", "minLength": 1},
        "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/safePath"}}
      }
    },
    "roles": {
      "type": "object",
      "required": ["agent_entry", "start_here", "mission", "current_state", "product_truth", "feature_inventory", "architecture_runtime", "run_deploy_operations", "quality_risks", "owner_decisions", "intelligence_markdown", "intelligence_json", "evidence_manifest"],
      "additionalProperties": {"$ref": "#/$defs/role"}
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.\\.|\\.git|\\.hg|\\.svn)(?:/|$))(?!.*\\\\).+$"
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "treatment", "authority", "reason", "evidence_ids", "owner_decision_ids", "freshness_trigger"],
      "properties": {
        "path": {"anyOf": [{"$ref": "#/$defs/safePath"}, {"type": "null"}]},
        "treatment": {"enum": ["CREATE", "UPDATE", "LINK", "AMEND", "SKIP", "BLOCKED"]},
        "authority": {"enum": ["CANONICAL", "SUPPORTING", "GENERATED_VIEW", "HISTORICAL", "NONE"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "owner_decision_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "freshness_trigger": {"type": "string", "minLength": 1}
      }
    }
  }
}
