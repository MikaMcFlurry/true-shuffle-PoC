{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mika.local/schemas/repo-handoff-evidence.v2.json",
  "title": "Mika Repository Handoff Evidence Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "analysis_baseline", "packet_sha256", "artifacts"],
  "properties": {
    "schema_version": {"const": "mika.repo-handoff-evidence.v2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "analysis_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "ref", "commit_sha"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"}
      }
    },
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "roles", "treatment", "authority", "evidence_ids", "owner_decision_ids", "freshness_trigger"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.\\.|\\.git|\\.hg|\\.svn)(?:/|$))(?!.*\\\\).+$"
          },
          "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "treatment": {"enum": ["CREATE", "UPDATE", "LINK", "AMEND"]},
          "authority": {"enum": ["CANONICAL", "SUPPORTING", "GENERATED_VIEW", "HISTORICAL"]},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "owner_decision_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "freshness_trigger": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
