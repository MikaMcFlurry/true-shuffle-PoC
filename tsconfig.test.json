{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"allowImportingTsExtensions": true
	},
	"include": [
		"test/**/*.ts",
		"e2e/**/*.ts",
		"src/core/**/*.ts",
		"src/shared/**/*.ts",
		"src/worker/hub/**/*.ts",
		"src/worker/spotify/**/*.ts",
		"src/worker/lib/**/*.ts",
		"src/worker/sources/**/*.ts",
		"*.config.ts"
	]
}
