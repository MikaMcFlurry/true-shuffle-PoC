// Local workerd only (wrangler dev): source/wrangler.e2e.jsonc with the fallback artifact's
// client assets and the Spotify stand-in on port 20988. Never deployed.
{
	"name": "true-shuffle-e2e",
	"main": "../../artifacts/fallback/worker/index.js",
 "no_bundle": true,
	"compatibility_date": "2026-09-20",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "../../artifacts/fallback/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/auth/*", "/remote/*"]
	},
	"durable_objects": {
		"bindings": [
			{ "name": "USER_HUB", "class_name": "UserHub" },
			{ "name": "REGISTRY", "class_name": "Registry" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserHub", "Registry"] }],
	"vars": {
		"SPOTIFY_CLIENT_ID": "e2e-client",
		"APP_SECRET": "e2e-secret-e2e-secret-e2e-secret-e2e-secret",
		"SPOTIFY_ACCOUNTS_BASE": "http://127.0.0.1:20988/accounts",
		"SPOTIFY_API_BASE": "http://127.0.0.1:20988/v1",
		"LASTFM_API_BASE": "http://127.0.0.1:20988/lastfm",
		"LASTFM_API_KEY": "e2e-lastfm",
		"DEEZER_API_BASE": "http://127.0.0.1:20988/deezer"
	}
}
