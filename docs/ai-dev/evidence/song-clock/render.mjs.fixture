import { build } from '/workspace/true-shuffle-PoC/node_modules/esbuild/lib/main.js';
import { chromium } from '/workspace/true-shuffle-PoC/node_modules/playwright-core/index.mjs';
import assert from 'node:assert/strict';
const repo='/workspace/true-shuffle-PoC';
const bundle=await build({stdin:{contents:`import {h,render} from 'preact'; import {SongProgress} from './src/client/components/song-progress'; window.draw=(props)=>render(h(SongProgress,props),document.getElementById('app')); window.removeClock=()=>render(null,document.getElementById('app'));`,resolveDir:repo,loader:'tsx'},bundle:true,write:false,format:'iife',jsx:'automatic',jsxImportSource:'preact'});
const browser=await chromium.launch({executablePath:'/usr/bin/chromium',headless:true});
const page=await browser.newPage();
await page.clock.install({time:new Date(100000)});
await page.setContent('<div id="app"></div>');
await page.addScriptTag({content:bundle.outputFiles[0].text});
let props={position:176000,observedAt:1000,serverTime:1000,receivedAt:100000,playing:true,durationMs:300000};
const draw=async(delta={})=>{props={...props,...delta};await page.evaluate(p=>window.draw(p),props);await page.clock.runFor(30);};
const label=()=>page.locator('.progress-labels span').first().innerText();
await draw();assert.equal(await label(),'2:56');
await page.clock.runFor(3000);assert.equal(await label(),'2:59');
await draw({serverTime:4000,receivedAt:103000});assert.equal(await label(),'2:59');
await page.clock.runFor(1000);assert.equal(await label(),'3:00');
await draw({position:12000,observedAt:5000,serverTime:5000,receivedAt:104000});assert.equal(await label(),'0:12');
await page.clock.runFor(1000);assert.equal(await label(),'0:13');
await draw({position:13000,observedAt:6000,serverTime:6000,receivedAt:105000,playing:false});assert.equal(await label(),'0:13 gespeichert');
await page.clock.runFor(3000);assert.equal(await label(),'0:13 gespeichert');
await draw({position:299000,observedAt:6000,serverTime:6000,receivedAt:108000,playing:true});
await page.clock.runFor(3000);assert.equal(await label(),'5:00');assert.equal(await page.locator('progress').getAttribute('value'),'300000');
await draw({playing:false});assert.equal(await label(),'4:59 gespeichert');
await draw({position:null});assert.match(await label(),/Position unbekannt/);
await draw({position:20000,observedAt:null,playing:true});assert.equal(await label(),'0:20 gespeichert');
await page.clock.runFor(2000);assert.equal(await label(),'0:20 gespeichert');
await page.evaluate(()=>window.removeClock());await page.clock.runFor(2000);assert.equal(await page.locator('progress').count(),0);
