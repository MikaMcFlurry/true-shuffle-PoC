< it('independent additive 7-to-8 migration preserves legacy import, preferences and account isolation',async()=>{const h=await onboarded({tracks:80,liked:1});const ts=[...h.fake.tracks.values()];const id=h.hub.importHistory([[ts[0].id,5,0,at,0,5]],0,1).upload;const meta=JSON.parse(h.sql.first("SELECT v FROM kv WHERE k='history_import'")!.v);delete meta.id;h.sql.run("UPDATE kv SET v=? WHERE k='history_import'",JSON.stringify(meta));const snapshots={hist:h.sql.all('SELECT * FROM hist_pages'),memory:h.sql.all('SELECT * FROM memory'),stations:h.sql.all('SELECT * FROM stations'),preferences:h.sql.all("SELECT k,v FROM kv WHERE k='settings'")};for(const table of ['hist_stage','hist_effective','playlist_scan','playlist_member_pages'])h.sql.run(`DROP TABLE ${table}`);h.sql.run("UPDATE kv SET v='7' WHERE k='schema_version'");h.restart();expect(h.sql.first("SELECT v FROM kv WHERE k='schema_version'")!.v).toBe('8');expect({hist:h.sql.all('SELECT * FROM hist_pages'),memory:h.sql.all('SELECT * FROM memory'),stations:h.sql.all('SELECT * FROM stations'),preferences:h.sql.all("SELECT k,v FROM kv WHERE k='settings'")}).toEqual(snapshots);expect(h.hub.memory(ts[0].id).plays).toBe(5);const other=await onboarded({tracks:80});h.hub.applySelection({baseRevision:0,enabled:false,rules:[]});expect(other.hub.selectionView().selection.enabled).toBe(true);expect(other.hub.memory(ts[0].id).plays).toBe(0);console.log('migration7to8',JSON.stringify({schema:8,snapshotsPreserved:true,legacyCoverage:h.hub.selectionView().dataset.coverage,other:other.hub.selectionView().dataset}));});
