# =============================================================================
# true-shuffle — configuration
#
# Copy to .env and fill in the services you want. A service with no credentials
# is shown as "needs setup" in the UI; the app still runs with the others.
# =============================================================================

# -- App ----------------------------------------------------------------------
# Must match the redirect URI registered with every service, exactly.
BASE_URL=http://127.0.0.1:8000

# Signs session cookies AND derives the key that encrypts stored tokens.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this makes every already-stored token unreadable (reconnect needed).
SECRET_KEY=change_me_to_a_random_string

DB_PATH=./data/true_shuffle.db
LOG_LEVEL=INFO


# -- Run behaviour ------------------------------------------------------------
# How many upcoming tracks to push into a provider's queue ahead of time.
QUEUE_BUFFER_SIZE=5
# Base poll interval for the playback watcher; it adapts to track length.
WATCHER_POLL_SECONDS=4
# Stop driving a run after this many seconds of no playback.
WATCHER_IDLE_TIMEOUT_SECONDS=900


# -- Spotify ------------------------------------------------------------------
# https://developer.spotify.com/dashboard → create app.
# Redirect URI to register:  http://127.0.0.1:8000/auth/spotify/callback
# PKCE public client — no client secret is used or needed.
# Live Mode needs Spotify Premium; Copy Mode works on free accounts.
SPOTIFY_CLIENT_ID=


# -- Apple Music --------------------------------------------------------------
# Requires a paid Apple Developer account with a MusicKit identifier and key.
#   1. Certificates, Identifiers & Profiles → Keys → new key with MusicKit.
#   2. Download the .p8 file (once only) and note the Key ID.
#   3. Team ID is in the top-right of the developer portal.
# Register this domain under the MusicKit identifier before connecting.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Either point at the .p8 file …
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
# … or paste its contents here instead (use \n for newlines).
APPLE_PRIVATE_KEY=
# Developer-token lifetime in days. Apple's hard maximum is 180.
APPLE_TOKEN_DAYS=150


# -- YouTube Music ------------------------------------------------------------
# There is no YouTube Music API. This uses the official YouTube Data API v3,
# where YouTube Music playlists appear as ordinary YouTube playlists.
#   1. https://console.cloud.google.com → new project.
#   2. Enable "YouTube Data API v3".
#   3. OAuth consent screen → add yourself as a test user.
#   4. Credentials → OAuth client ID → Web application.
# Redirect URI to register:  http://127.0.0.1:8000/auth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Daily quota units the project may spend. Used to refuse a Copy-Mode write
# that provably cannot finish (each added track costs 50 units).
YOUTUBE_DAILY_QUOTA=10000


# -- YouTube Music, unofficial (OPT-IN, off by default) -----------------------
# A SECOND YouTube Music connector, built on `ytmusicapi`, a reverse-engineered
# client for YouTube's INTERNAL API.
#
# It reaches what no public API exposes: your YouTube Music library, "Liked
# Music", uploads, and your listening history — the last of which also makes
# Handoff Mode work here with nothing of ours open.
#
# The trade, stated plainly: it can break at any time without notice, and using
# it is very likely against YouTube's terms of service. The official connector
# above needs none of this and stays the default.
#
# Both of these are required; either alone does nothing:
#   pip install -r requirements-optional.txt
#   ENABLE_UNOFFICIAL_YTMUSIC=true
# Then run `ytmusicapi browser` and paste the resulting browser.json in the app.
ENABLE_UNOFFICIAL_YTMUSIC=false
